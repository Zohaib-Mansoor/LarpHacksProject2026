{
  "name": "larping-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "api:dev": "tsx watch src/server.ts",
    "api:start": "tsx src/server.ts",
    "api:test": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run tests/lobby.test.ts --maxWorkers=1",
    "api:typecheck": "tsc -p tsconfig.api.json",
    "start": "npm --prefix playcall start",
    "dev": "npm --prefix playcall run dev",
    "test": "npm --prefix playcall test",
    "check": "npm --prefix playcall run check",
    "db:auth:generate": "auth generate --config ./scripts/auth-schema.config.ts --adapter drizzle --dialect postgresql --output ./src/db/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:verify": "tsx --env-file-if-exists=.env scripts/verify-schema.ts",
    "db:typecheck": "tsc --project tsconfig.db.json",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:preview": "npm --prefix web run preview"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@fastify/type-provider-typebox": "^6.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "auth": "1.7.15",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
