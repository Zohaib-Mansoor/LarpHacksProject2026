{
  "name": "larping-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "api:dev": "npm --prefix backend run dev",
    "api:start": "npm --prefix backend start",
    "api:test": "npm --prefix backend test",
    "api:typecheck": "npm --prefix backend run typecheck",
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "test": "npm --prefix backend test",
    "check": "npm --prefix backend run typecheck && npm --prefix backend run lint",
    "build": "npm --prefix backend run build",
    "frontend:prototype": "npm --prefix playcall start",
    "playcall:start": "npm --prefix web run build && npm --prefix playcall start",
    "playcall:test": "npm --prefix playcall test",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:preview": "npm --prefix web run preview",
    "db:legacy:migrate": "drizzle-kit migrate",
    "db:legacy:verify": "tsx --env-file-if-exists=.env scripts/verify-schema.ts",
    "db:auth:generate": "npm --prefix backend run auth:generate",
    "db:generate": "npm --prefix backend run db:generate",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:studio": "npm --prefix backend run db:studio",
    "db:verify": "npm --prefix backend test",
    "db:typecheck": "npm --prefix backend run typecheck"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@fastify/type-provider-typebox": "^6.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "auth": "^1.7.15",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
