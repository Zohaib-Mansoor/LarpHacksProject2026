NODE_ENV=development
HOST=127.0.0.1
PORT=4173
DEMO_MODE=true
DATABASE_URL=postgresql://rolecall:rolecall_local@localhost:5432/rolecall_integrated
BETTER_AUTH_URL=http://127.0.0.1:4173
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_ORIGINS=http://127.0.0.1:4173
# DEMO_MODE=true serves the frontend on this same origin, with polling and text chat.
# Audio, WebSockets, and workers are not registered in this mode.
# Optional AI situation generation is available in text mode.
# Optional: enable Google sign-in when both are supplied.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gemini is the preferred provider when GEMINI_API_KEY is configured.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional alternative: set AI_PROVIDER=openai and configure these instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional voice-game AI coaching: needs ELEVENLABS_API_KEY and one configured AI provider.
# Leave blank to keep AI coaching disabled. Keys stay on the backend.
# Uses batch Scribe v2 after each consented 45-second turn, with no WebSockets/workers.
ELEVENLABS_API_KEY=
# Direct WebRTC calls. STUN carries connection setup metadata, not the call audio.
RTC_STUN_URLS=stun:stun.l.google.com:19302
# Keep false for strict browser-to-browser calls. Some networks cannot connect directly.
RTC_ALLOW_RELAY=false
# Optional coturn fallback: only used when RTC_ALLOW_RELAY=true.
TURN_URL=
TURN_SHARED_SECRET=
