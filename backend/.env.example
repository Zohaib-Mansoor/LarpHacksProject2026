NODE_ENV=development
HOST=127.0.0.1
PORT=4173
DEMO_MODE=true
DATABASE_URL=postgresql://rolecall:rolecall_local@localhost:5432/rolecall_integrated
BETTER_AUTH_URL=http://127.0.0.1:4173
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_ORIGINS=http://127.0.0.1:4173
# DEMO_MODE=true serves the frontend on this same origin, with polling and text chat.
# Audio, AI calls, WebSockets, and workers are not registered in this mode.
# Optional: enable Google sign-in when both are supplied.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set these to generate situations and provide evidence-based AI feedback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Realtime speech recognition: this key stays on the backend.
ELEVENLABS_API_KEY=
# Direct WebRTC calls. STUN carries connection setup metadata, not the call audio.
RTC_STUN_URLS=stun:stun.l.google.com:19302
# Keep false for strict browser-to-browser calls. Some networks cannot connect directly.
RTC_ALLOW_RELAY=false
# Optional coturn fallback: only used when RTC_ALLOW_RELAY=true.
TURN_URL=
TURN_SHARED_SECRET=
