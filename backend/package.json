{
  "name": "@rolecall/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:browser": "node e2e/realtime.mjs",
    "test:browser:legacy": "node e2e/flow.mjs",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "auth:generate": "auth generate --config auth.config.ts --adapter drizzle --dialect postgresql --output src/db/auth-schema.ts --yes",
    "db:migrate:prod": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.15",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.3",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@fastify/websocket": "^11.3.6",
    "better-auth": "^1.7.15",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "livekit-server-sdk": "^2.19.2",
    "openai": "^7.47.0",
    "pg": "^8.23.1",
    "typebox": "^1.4.3",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "auth": "^1.7.15",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "minimatch": "^11.0.1"
  }
}
